APP_NAME=NeuroScan API
ENVIRONMENT=development
# Paste the Neon connection string here when available. Use the pooled connection string for app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Use a random secret of at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_MINUTES=10
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NeuroScan
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-scout
OPENROUTER_APP_NAME=NeuroScan
