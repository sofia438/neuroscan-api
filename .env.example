APP_NAME=NeuroScan API
ENVIRONMENT=development
# Neon pooled URL for application traffic. Keep the password private in your local .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional direct Neon URL for Alembic migrations; fall back to DATABASE_URL when omitted.
MIGRATION_DATABASE_URL=
# Use a random secret of at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
OTP_EXPIRY_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_MINUTES=10
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NeuroScan
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-scout
OPENROUTER_APP_NAME=NeuroScan
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
GOOGLE_STATE_TTL_SECONDS=600
GOOGLE_HANDOFF_TTL_SECONDS=90
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MRI_STORAGE_DIR=./storage/mri
MRI_MAX_UPLOAD_BYTES=2147483648
DOCTOR_APPROVAL_REQUIRED=false
